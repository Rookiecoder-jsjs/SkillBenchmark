{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillbenchmark.dev/schemas/suite-snapshot.schema.json",
  "title": "SuiteSnapshot",
  "type": "object",
  "required": ["schema_version", "suite_id", "label", "digest", "tasks", "split_policy", "metric_policy"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "suite_id": { "type": "string" },
    "label": { "type": "string" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "split_policy": { "type": "string" },
    "metric_policy": { "type": "string" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["task_id", "family_id", "source_group", "split", "prompt", "expected_output", "mock_outputs", "tags"],
      "properties": {
        "task_id": { "type": "string" },
        "family_id": { "type": "string" },
        "source_group": { "type": "string" },
        "split": { "enum": ["train", "validation", "test"] },
        "prompt": { "type": "string" },
        "expected_output": { "type": "string" },
        "mock_outputs": { "type": "object", "additionalProperties": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
