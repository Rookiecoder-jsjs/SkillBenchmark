{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillbenchmark.dev/schemas/run-plan.schema.json",
  "title": "RunPlan",
  "type": "object",
  "required": ["schema_version", "run_id", "suite_id", "suite_digest", "profiles", "conditions", "repeats", "budget", "fingerprint", "trials"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "suite_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
    "conditions": { "type": "array", "minItems": 1, "items": { "enum": ["none", "incumbent", "candidate"] } },
    "repeats": { "type": "integer", "minimum": 1 },
    "budget": { "$ref": "#/$defs/budget" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trials": { "type": "array", "items": { "$ref": "#/$defs/trial" } }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["profile_id", "platform", "platform_version", "adapter_version", "model", "config_digest", "capabilities"],
      "properties": {
        "profile_id": { "type": "string" },
        "platform": { "type": "string" },
        "platform_version": { "type": "string" },
        "adapter_version": { "type": "string" },
        "model": { "type": "string" },
        "config_digest": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_trials", "max_attempts", "concurrency", "timeout_ms"],
      "properties": {
        "max_trials": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": ["trial_id", "run_id", "task_id", "profile_id", "condition_id", "repeat_index", "attempt"],
      "properties": {
        "trial_id": { "type": "string" },
        "run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "profile_id": { "type": "string" },
        "condition_id": { "enum": ["none", "incumbent", "candidate"] },
        "repeat_index": { "type": "integer", "minimum": 1 },
        "attempt": { "const": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
